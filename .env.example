# ==============================================================================
# coffeeTide Environment Variables  (참조: doc/01-as-built-reference.md §6)
# ==============================================================================

# true면 실제 연동/AI 통신 없이 Mock 데이터로 동작
MOCK_MODE=true

# Supabase Auth 및 사용자별 클라우드 동기화
NEXT_PUBLIC_SITE_URL=https://coffee-tide.dongple.kr
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 개인정보처리방침에 표시할 운영 담당자 정보
NEXT_PUBLIC_PRIVACY_CONTACT_NAME=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
# 서버 전용: Spark 웹훅의 DB 저장에만 사용. 브라우저/NEXT_PUBLIC에 노출 금지.
SUPABASE_SECRET_KEY=

# 세션 쿠키 AES-256-GCM 암호화 키 (32바이트 base64)
# 생성(PowerShell): [Convert]::ToBase64String((1..32 | % { [byte](Get-Random -Min 0 -Max 256) }))
# 프로덕션에서 미설정 시 서버가 기동을 거부합니다 (백로그 B1).
SESSION_ENCRYPTION_SECRET=
# 선택: 외부 연동 토큰 전용 키. 비우면 SESSION_ENCRYPTION_SECRET에서 별도 키를 파생합니다.
INTEGRATION_ENCRYPTION_SECRET=

# Gemini API 키 (분류·브리핑·답장·규칙파싱). 없으면 로컬 FallbackEngine으로 대체.
GEMINI_API_KEY=
# true면 AI 바리스타의 자연어 Cloud Tool 자동 선택만 끕니다. 명시적 /tool 명령은 유지됩니다.
DISABLE_CLOUD_TOOL_AGENT=false

# Microsoft Entra ID (Outlook 연동) — doc/0-prerequisites.md 참조
NEXT_PUBLIC_MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
# Outlook callback은 NEXT_PUBLIC_SITE_URL 기준으로 서버에서 생성합니다.

# Google Identity 로그인 + 입장 후 Google OAuth (Gmail 읽기·Calendar 일정 쓰기·Drive 앱 파일)
# Google Auth Platform의 Authorized JavaScript origins에 로컬/운영 CoffeeTide origin을 추가합니다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google callback은 NEXT_PUBLIC_SITE_URL 기준으로 서버에서 생성합니다.

# Notion 내부 통합 (개발/수동 테스트용 기본값 — UI에서 세션별 입력도 가능)
NOTION_INTEGRATION_TOKEN=
NOTION_DATABASE_ID=

# (선택) LLM 산출물 기본 폴더 경로 (doc/spec/phase6-llm-artifacts.md)
LLM_ARTIFACTS_DEFAULT_PATH=

# 웹 푸시 (아침 브리핑 알림 — 백로그 H5). 생성: npx web-push generate-vapid-keys
# 미설정 시 알림 기능만 비활성화되고 나머지는 정상 동작.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 클라우드 배포에서 /api/briefing/daily 를 외부 크론으로 호출할 때의 인증 토큰 — Vercel 등에서 필수.
# 미설정이면 해당 엔드포인트는 503으로 잠깁니다 (셀프호스팅 내장 스케줄러는 영향 없음).
# Vercel은 프로젝트에 CRON_SECRET이 있으면 Cron 호출 시 자동으로 Authorization: Bearer 헤더에 실어 보냄.
CRON_SECRET=

# Gemini Spark 등 외부 자동화가 /api/spark/ingest로 이벤트를 보낼 때 쓰는 Bearer 토큰.
# 프로덕션에서는 필수이며, 수신 요청은 Authorization: Bearer <값> 헤더를 포함해야 합니다.
SPARK_INGEST_SECRET=

# 공공데이터포털(data.go.kr) 공용 인증키 (기상청 단기예보 · TAGO 대중교통 · 한국도로공사 공통)
# 기존 WEATHER_API_KEY도 하위호환(별칭)으로 자동 지원됩니다.
DATA_GO_KR_SERVICE_KEY=

# 빠른 위젯 `환율·금리` — 서버 전용 공식 공공데이터 인증키
# 한국은행 ECOS Open API (환율·기준금리): https://ecos.bok.or.kr/api/#/
BOK_ECOS_API_KEY=

# (선택) OpenWeatherMap 전용 API 키 (기상청 실패 시 해외/폴백용)
OPENWEATHER_API_KEY=

# (선택) 푸시 구독 프로필 저장소 — Upstash Redis (https://console.upstash.com 에서 발급)
# 미설정 시 data/push-profiles.json 파일 사용. Vercel 등 서버리스 배포에서는 파일이 휘발되므로 필수.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 로컬 CoffeeTide 전용 등록형 도구 JSON의 절대 경로. Vercel에서는 항상 비활성화됩니다.
# 예시 형식: doc/local-tools.registry.example.json
LOCAL_TOOL_REGISTRY_PATH=
# true면 앱/URL 바로가기와 등록형 로컬 도구 실행을 모두 차단합니다.
DISABLE_LOCAL_EXEC=false

# 선택: Cloud Tool 감사 로그의 사용자 식별자 해시 솔트. 비우면 SESSION_ENCRYPTION_SECRET을 사용합니다.
CLOUD_TOOL_AUDIT_SALT=

